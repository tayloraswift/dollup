#!/bin/bash

set -euo pipefail

product="${DEPLOY_PRODUCT:-dollup}"
arch=$(uname -m)
os=$(uname)

if [ -z "$DEPLOY_VERSION" ]; then
    echo "DEPLOY_VERSION is not set"
    exit 1
fi

if [[ "$os" == 'Darwin' ]]; then
    swift build -c release \
        --product "${product}" \
        --scratch-path .build.${arch}
elif [[ "$os" == 'Linux' ]]; then
    swift build -c release \
        --product "${product}" \
        --scratch-path .build.${arch} \
        --static-swift-stdlib
else
    echo "Unsupported OS"
    exit 1
fi

.build.${arch}/release/${product} bundle --version "${DEPLOY_VERSION}"
